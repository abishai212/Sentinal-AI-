# Sentinel AI Platform Environment Configuration
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/ai_marketplace
JWT_SECRET=replace_with_a_long_secure_random_string_in_production

# Gemini API (keep the real key only in backend/.env; never commit it)
GEMINI_API_KEY=replace_with_your_rotated_gemini_api_key
# Optional: set one model to bypass discovery and use a single-model override
GEMINI_MODEL=
# Optional: comma-separated models to try first, in priority order
GEMINI_MODELS=
AI_MAX_REQUESTS_PER_MINUTE=8
DEMO_FILENAME_HINTS=true

# Optional: Nodemailer Gmail SMTP for Email alerts (Leave blank to use mock console logging)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Optional: Twilio SMS / WhatsApp credentials (Leave blank to use mock console logging)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Required for admin console access
ADMIN_USERNAME= Admin
ADMIN_PASSWORD=212345
ADMIN_JWT_SECRET=replace_with_a_secure_admin_secret
